RATE_LIMIT_SALT=REPLACE-WITH-RANDOM-32-BYTES
TURNSTILE_SECRET_KEY=YOUR-TURNSTILE-SECRET
RESEND_API_KEY=re_REPLACE
EMAIL_FROM=CARE ENTRY <entry@YOUR-VERIFIED-DOMAIN>
NOTIFY_EMAIL=t-sugimoto@kikari.co.jp
CRON_SECRET=REPLACE-WITH-ANOTHER-RANDOM-32-BYTES
