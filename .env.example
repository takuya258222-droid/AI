# LINE Messaging API（LINE Developers → Messaging API設定）
LINE_CHANNEL_ACCESS_TOKEN=your_channel_access_token_here
LINE_CHANNEL_SECRET=your_channel_secret_here

# 任意
# ADMIN_USER_ID=U0123456789abcdef       # 運営者のLINE userId（スクショ通知・「統計」用）
# PUBLIC_BASE_URL=https://your-bot.example.com   # 画像URLの基準（省略時はリクエストURL）
# PORT=3000                              # Node版サーバーのポート
