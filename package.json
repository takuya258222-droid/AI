{
  "name": "career-line-bot",
  "version": "1.0.0",
  "description": "転職アフィリエイト用LINE公式アカウントBot（30秒診断・年収診断・キャンペーン・体験記）",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/adapters/node-server.mjs",
    "test": "node scripts/test-matcher.mjs && node scripts/simulate.mjs",
    "assets": "node scripts/build-assets.mjs",
    "validate": "node --env-file-if-exists=.env scripts/validate-messages.mjs",
    "richmenu": "node --env-file-if-exists=.env scripts/setup-richmenu.mjs",
    "richmenu:activate": "node --env-file-if-exists=.env scripts/setup-richmenu.mjs --activate",
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "docs": "node scripts/build-docs.mjs",
    "pages": "node scripts/build-pages.mjs",
    "e2e": "node scripts/e2e-worker.mjs"
  },
  "dependencies": {
    "playwright": "^1.63.0"
  },
  "private": true,
  "devDependencies": {
    "wrangler": "^4.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
